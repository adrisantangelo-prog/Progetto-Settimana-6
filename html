<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SitoWeb Atelier</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <link rel="stylesheet" href="assent\css\style.css">
    <title>Document</title>
</head>

<body>

    <!-- NAVBAR -->
    <nav class="navbar navbar-expand-md navbar-dark navbar-atelier sticky-top">
        <div class="container">
            <a class="navbar-brand" href="#">Atelier</a>

            <!-- Bottone tema chiaro / scuro -->
            <button type="button" id="themeToggle"
                class="btn btn-sm btn-outline-light theme-toggle ms-auto me-2 ms-md-3 me-md-0 order-md-last"
                aria-label="Passa al tema scuro" title="Passa al tema scuro">
                <span class="theme-icon" aria-hidden="true">🌙</span>
            </button>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                aria-controls="mainNav" aria-expanded="false" aria-label="Apri menu">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="mainNav">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item"><a class="nav-link" href="#studio">Studio</a></li>
                    <li class="nav-item"><a class="nav-link" href="#servizi">Servizi</a></li>
                    <li class="nav-item"><a class="nav-link" href="#lavori">Lavori</a></li>
                    <li class="nav-item"><a class="nav-link" href="#contatti">Contatti</a></li>
                </ul>
            </div>
        </div>
    </nav>

    <!-- HERO -->
    <header id="studio" class="hero text-white text-center">
        <div class="container py-5">
            <h1 class="mb-3">Architettura per spazi che parlano</h1>
            <p class="mb-4">Progettiamo case, uffici e spazi commerciali con attenzione alla luce, ai materiali e al
                contesto.</p>
            <button type="button" class="btn btn-brand" data-bs-toggle="modal" data-bs-target="#projectModal">
                Inizia un progetto
            </button>
        </div>
    </header>

    <!-- SERVIZI -->
    <section id="servizi" class="py-5">
        <div class="container">
            <div class="text-center mb-4">
                <h2 class="section-title mb-1">I nostri servizi</h2>
                <p class="text-secondary small">Sei aree di lavoro, una sola attenzione alla qualità.</p>
            </div>

            <div class="row g-4">
                <div class="col-md-6 col-lg-4">
                    <div class="card service-card h-100 text-center">
                        <div class="card-body p-4">
                            <div class="icon mb-3">🏠</div>
                            <h3 class="card-title">Progettazione residenziale</h3>
                            <p class="card-text text-secondary small">Case private, ville e ristrutturazioni domestiche,
                                dal sopralluogo alla consegna delle chiavi.</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-6 col-lg-4">
                    <div class="card service-card h-100 text-center">
                        <div class="card-body p-4">
                            <div class="icon mb-3">🪑</div>
                            <h3 class="card-title">Interior design</h3>
                            <p class="card-text text-secondary small">Allestimenti d'interno per case e uffici, con
                                materiali selezionati e arredo su misura.</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-6 col-lg-4">
                    <div class="card service-card h-100 text-center">
                        <div class="card-body p-4">
                            <div class="icon mb-3">🧱</div>
                            <h3 class="card-title">Ristrutturazioni</h3>
                            <p class="card-text text-secondary small">Riqualificazione di spazi esistenti, gestione dei
                                lavori e coordinamento con le imprese.</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-6 col-lg-4">
                    <div class="card service-card h-100 text-center">
                        <div class="card-body p-4">
                            <div class="icon mb-3">🏢</div>
                            <h3 class="card-title">Spazi commerciali</h3>
                            <p class="card-text text-secondary small">Negozi, uffici e showroom pensati per accogliere i
                                clienti e raccontare il tuo marchio.</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-6 col-lg-4">
                    <div class="card service-card h-100 text-center">
                        <div class="card-body p-4">
                            <div class="icon mb-3">🌿</div>
                            <h3 class="card-title">Progettazione del verde</h3>
                            <p class="card-text text-secondary small">Giardini, terrazzi e cortili che dialogano con
                                l'architettura e con le stagioni.</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-6 col-lg-4">
                    <div class="card service-card h-100 text-center">
                        <div class="card-body p-4">
                            <div class="icon mb-3">💡</div>
                            <h3 class="card-title">Consulenza energetica</h3>
                            <p class="card-text text-secondary small">Analisi dei consumi, isolamento e impianti per
                                case più efficienti e confortevoli.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- LAVORI -->
    <section id="lavori" class="py-5 border-top">
        <div class="container">
            <div class="text-center mb-4">
                <h2 class="section-title mb-1">I nostri lavori</h2>
                <p class="text-secondary small">Una selezione dei progetti realizzati negli ultimi anni.</p>
            </div>

            <!-- FILTRI: un solo listener sul contenitore (event delegation) -->
            <div id="filtri" class="d-flex flex-wrap gap-2 justify-content-center mb-3">
                <button type="button" class="btn btn-filtro btn-sm active" data-categoria="tutti"
                    aria-pressed="true">Tutti</button>
                <button type="button" class="btn btn-filtro btn-sm" data-categoria="residenziale"
                    aria-pressed="false">Residenziale</button>
                <button type="button" class="btn btn-filtro btn-sm" data-categoria="interni"
                    aria-pressed="false">Interni</button>
                <button type="button" class="btn btn-filtro btn-sm" data-categoria="ristrutturazione"
                    aria-pressed="false">Ristrutturazione</button>
                <button type="button" class="btn btn-filtro btn-sm" data-categoria="commerciale"
                    aria-pressed="false">Commerciale</button>
            </div>

            <!-- CONTATORE: aggiornato da renderLavori -->
            <p class="text-secondary small text-center mb-4" aria-live="polite">
                Mostrati: <span id="contatore">0</span> su <span id="contatore-totale">0</span>
            </p>

            <!-- Griglia: 1 per riga (mobile) / 2 (md) / 3 (lg) -->
            <!-- Le card vengono generate da JavaScript (array "lavori") -->
            <div class="row g-4" id="lavori-container"></div>
        </div>
    </section>

    <!-- CONTATTI -->
    <section id="contatti" class="py-5 bg-light">
        <div class="container">
            <div class="text-center mb-4">
                <h2 class="section-title mb-1">Contattaci</h2>
                <p class="text-secondary small">Compila il form, ti rispondiamo entro 48 ore.</p>
            </div>

            <div class="row justify-content-center">
                <div class="col-md-8 col-lg-6">
                    <div id="contactAlert" class="alert alert-success small d-none" role="alert">
                        Grazie! Abbiamo ricevuto il tuo messaggio.
                    </div>

                    <form id="contactForm" novalidate>
                        <div class="mb-3">
                            <label for="nome" class="form-label small">Nome</label>
                            <input type="text" class="form-control form-control-sm" id="nome" required>
                            <div class="invalid-feedback">Inserisci il tuo nome.</div>
                        </div>
                        <div class="mb-3">
                            <label for="email" class="form-label small">Email</label>
                            <input type="email" class="form-control form-control-sm" id="email" required>
                            <div class="invalid-feedback">Inserisci un indirizzo email valido.</div>
                        </div>
                        <div class="mb-3">
                            <label for="tipo" class="form-label small">Tipo di progetto</label>
                            <select class="form-select form-select-sm" id="tipo">
                                <option selected>Residenziale</option>
                                <option>Interior design</option>
                                <option>Ristrutturazione</option>
                                <option>Spazi commerciali</option>
                                <option>Progettazione del verde</option>
                                <option>Consulenza energetica</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label for="messaggio" class="form-label small">Messaggio</label>
                            <textarea class="form-control form-control-sm" id="messaggio" rows="4" required></textarea>
                            <div class="invalid-feedback">Scrivi un messaggio.</div>
                        </div>
                        <button type="submit" class="btn btn-brand btn-sm w-100">Invia</button>
                    </form>
                </div>
            </div>
        </div>
    </section>

    <!-- FOOTER -->
    <footer class="footer-atelier pt-5 pb-4">
        <div class="container">
            <div class="row g-4">
                <div class="col-md-4">
                    <h5>Atelier</h5>
                    <p class="mb-0">Studio di architettura<br>Via dei Pioppi 12, Milano</p>
                </div>
                <div class="col-md-4">
                    <h5>Link</h5>
                    <ul class="list-unstyled mb-0">
                        <li><a href="#studio">Studio</a></li>
                        <li><a href="#servizi">Servizi</a></li>
                        <li><a href="#lavori">Lavori</a></li>
                        <li><a href="#contatti">Contatti</a></li>
                    </ul>
                </div>
                <div class="col-md-4">
                    <h5>Contatti</h5>
                    <ul class="list-unstyled mb-0">
                        <li><a href="mailto:info@atelier.example">info@atelier.example</a></li>
                        <li><a href="tel:+390200001111">+39 02 0000 1111</a></li>
                    </ul>
                </div>
            </div>
            <hr class="my-4">
            <p class="text-center small mb-0">© <span id="year">2026</span> Atelier — tutti i diritti riservati</p>
        </div>
    </footer>

    <!-- MODALE "INIZIA UN PROGETTO" -->
    <div class="modal fade modal-atelier" id="projectModal" tabindex="-1" aria-labelledby="projectModalLabel"
        aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h2 class="modal-title" id="projectModalLabel">Inizia un progetto</h2>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"
                        aria-label="Chiudi"></button>
                </div>

                <div class="modal-body p-4">
                    <!-- Form -->
                    <div id="projectFormWrap">
                        <p class="text-secondary small mb-3">Raccontaci la tua idea: ti ricontattiamo per fissare un
                            primo incontro gratuito.</p>
                        <form id="projectForm" novalidate>
                            <div class="row g-3">
                                <div class="col-sm-6">
                                    <label for="pNome" class="form-label small">Nome</label>
                                    <input type="text" class="form-control form-control-sm" id="pNome" required>
                                    <div class="invalid-feedback">Inserisci il tuo nome.</div>
                                </div>
                                <div class="col-sm-6">
                                    <label for="pEmail" class="form-label small">Email</label>
                                    <input type="email" class="form-control form-control-sm" id="pEmail" required>
                                    <div class="invalid-feedback">Email non valida.</div>
                                </div>
                                <div class="col-sm-6">
                                    <label for="pTipo" class="form-label small">Tipo di progetto</label>
                                    <select class="form-select form-select-sm" id="pTipo">
                                        <option selected>Residenziale</option>
                                        <option>Interior design</option>
                                        <option>Ristrutturazione</option>
                                        <option>Spazi commerciali</option>
                                        <option>Progettazione del verde</option>
                                        <option>Consulenza energetica</option>
                                    </select>
                                </div>
                                <div class="col-sm-6">
                                    <label for="pBudget" class="form-label small">Budget indicativo</label>
                                    <select class="form-select form-select-sm" id="pBudget">
                                        <option selected>Fino a 20.000 €</option>
                                        <option>20.000 – 50.000 €</option>
                                        <option>50.000 – 100.000 €</option>
                                        <option>Oltre 100.000 €</option>
                                    </select>
                                </div>
                                <div class="col-12">
                                    <label for="pDescrizione" class="form-label small">Descrivi il progetto</label>
                                    <textarea class="form-control form-control-sm" id="pDescrizione" rows="3"
                                        required></textarea>
                                    <div class="invalid-feedback">Aggiungi una breve descrizione.</div>
                                </div>
                                <div class="col-12">
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" id="pPrivacy" required>
                                        <label class="form-check-label small" for="pPrivacy">Accetto il trattamento dei
                                            dati personali</label>
                                        <div class="invalid-feedback">Devi accettare per proseguire.</div>
                                    </div>
                                </div>
                            </div>
                            <div class="d-flex gap-2 justify-content-end mt-4">
                                <button type="button" class="btn btn-outline-secondary btn-sm"
                                    data-bs-dismiss="modal">Annulla</button>
                                <button type="submit" class="btn btn-brand btn-sm">Invia richiesta</button>
                            </div>
                        </form>
                    </div>

                    <!-- Conferma -->
                    <div id="projectSuccess" class="text-center py-3 d-none">
                        <div class="fs-1 mb-2">✅</div>
                        <h3 class="h5 fw-bold">Richiesta inviata!</h3>
                        <p class="text-secondary small">Grazie, ti contatteremo entro 48 ore.</p>
                        <button type="button" id="projectDone" class="btn btn-brand btn-sm">Chiudi</button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Modali dei lavori (generate da script.js) -->
    <div id="modals-container"></div>

    <!-- TEMPLATE: card di un lavoro -->
    <template id="tpl-card">
        <div class="col-12 col-md-6 col-lg-4">
            <article
                class="card lavoro-card colore-categoria h-100 border-0 border-top border-4 shadow-sm overflow-hidden"
                data-categoria="">
                <div class="ratio ratio-16x9 lavoro-cover" aria-hidden="true">
                    <div class="d-flex align-items-center justify-content-center">
                        <span class="lavoro-icona display-4"></span>
                    </div>
                </div>
                <div class="card-body p-4">
                    <span class="badge badge-categoria text-capitalize fw-medium mb-2"></span>
                    <h3 class="card-title fs-5 fw-bold"></h3>
                    <p class="lavoro-meta small text-body-secondary mb-2"></p>
                    <p class="lavoro-descrizione card-text small text-body-secondary mb-0"></p>
                </div>
                <div class="card-footer bg-transparent border-0 px-4 pb-4 pt-0">
                    <button type="button" class="btn btn-brand btn-sm w-100" data-bs-toggle="modal">Scopri il
                        progetto</button>
                </div>
            </article>
        </div>
    </template>

    <!-- TEMPLATE: modale di dettaglio di un lavoro -->
    <template id="tpl-modal">
        <div class="modal fade modal-atelier" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content colore-categoria overflow-hidden" data-categoria="">
                    <div class="modal-header">
                        <h2 class="modal-title"></h2>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"
                            aria-label="Chiudi"></button>
                    </div>
                    <div class="ratio ratio-21x9 lavoro-cover" aria-hidden="true">
                        <div class="d-flex align-items-center justify-content-center">
                            <span class="lavoro-icona display-3"></span>
                        </div>
                    </div>
                    <div class="modal-body p-4">
                        <span class="badge badge-categoria text-capitalize fw-medium mb-3"></span>
                        <dl class="row small mb-3">
                            <dt class="col-4">Luogo</dt>
                            <dd class="col-8 mb-1 lavoro-luogo"></dd>
                            <dt class="col-4">Anno</dt>
                            <dd class="col-8 mb-1 lavoro-anno"></dd>
                            <dt class="col-4">Superficie</dt>
                            <dd class="col-8 mb-1 lavoro-mq"></dd>
                        </dl>
                        <p class="lavoro-descrizione small text-body-secondary mb-0"></p>
                    </div>
                    <div class="modal-footer border-0 pt-0 px-4 pb-4">
                        <button type="button" class="btn btn-outline-secondary btn-sm"
                            data-bs-dismiss="modal">Chiudi</button>
                        <button type="button" class="btn btn-brand btn-sm lavoro-richiedi">Richiedi un progetto
                            simile</button>
                    </div>
                </div>
            </div>
        </div>
    </template>

    <!-- Contenuto del bottone durante l'invio (clonato da script.js) -->
    <template id="spinnerTemplate">
        <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>
        <span>Invio…</span>
    </template>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
    <script src="assent\js\style.js"></script>
</body>

</html>